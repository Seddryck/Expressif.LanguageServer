<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Expressif" Version="2.48.0" GeneratePathProperty="true" />
    <PackageReference Include="Expressif.Serialization" Version="2.48.0" />
    <PackageReference Include="Expressif.Syntax" Version="0.36.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgExpressif)\lib\$(TargetFramework)\Expressif.xml"
          Link="Expressif.xml"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
